---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBanner from '../../components/NewsletterBanner.astro';
import AdUnit from '../../components/AdUnit.astro';
import { SITE } from '../../config/site';
import { formatDate, formatDateISO, readingTime, generateBreadcrumbSchema } from '../../utils/helpers';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await guide.render();

const minutes = readingTime(guide.body);
const canonicalUrl = `${SITE.url}/guias/${guide.slug}`;
const ogImage = (data.heroImage as unknown as string) ?? `${SITE.url}/og-default.jpg`;

const breadcrumbs = generateBreadcrumbSchema([
  { name: 'Início', url: SITE.url },
  { name: 'Guias', url: `${SITE.url}/guias` },
  { name: data.title, url: canonicalUrl },
]);

const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelGuide',
  name: data.title,
  description: data.description,
  url: canonicalUrl,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: data.author ?? SITE.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    '@type': 'TouristDestination',
    name: data.destination,
    containedInPlace: {
      '@type': 'Country',
      name: data.country,
    },
  },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
  structuredData={[guideSchema, breadcrumbs]}
>
  <!-- Reading progress -->
  <div id="reading-progress" class="reading-progress" role="progressbar" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100} aria-label="Progresso de leitura" />

  <!-- Breadcrumb -->
  <nav class="container-site pt-4" aria-label="Trilha de navegação">
    <ol class="flex items-center gap-2 text-xs flex-wrap" style="color: var(--color-text-faint);">
      <li><a href="/" class="hover:text-muted transition-colors">Início</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/guias" class="hover:text-muted transition-colors">Guias</a></li>
      <li aria-hidden="true">›</li>
      <li class="line-clamp-1 max-w-48" style="color: var(--color-text-muted);">{data.title}</li>
    </ol>
  </nav>

  <article class="pt-10 pb-16">
    <!-- Header -->
    <header class="container-narrow mb-10">
      <!-- Meta badges -->
      <div class="flex flex-wrap gap-2 mb-5">
        <span class="badge-sage">{data.country}</span>
        <span class="badge badge-stone">📍 {data.destination}</span>
        {data.duration && <span class="badge badge-stone">⏱ {data.duration}</span>}
        {data.budget && <span class="badge badge-stone">💰 {data.budget}</span>}
        {data.difficulty && <span class="badge badge-stone">🏃 {data.difficulty}</span>}
      </div>

      <!-- Title -->
      <h1
        class="font-display font-medium mb-4 text-balance"
        style="font-size: clamp(2rem, 1.2rem + 2.5vw, 3.5rem); color: var(--color-heading); letter-spacing: -0.03em; line-height: 1.1;"
      >
        {data.title}
      </h1>

      <p
        class="text-lg leading-relaxed mb-6"
        style="color: var(--color-text-muted); font-family: var(--font-serif);"
      >
        {data.description}
      </p>

      <!-- Best for -->
      {data.bestFor.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <span class="text-xs font-medium" style="color: var(--color-text-faint);">Ideal para:</span>
          {data.bestFor.map((item) => (
            <span class="text-xs px-2.5 py-1 rounded-full" style="background: var(--color-bg-alt); color: var(--color-text-muted);">
              {item}
            </span>
          ))}
        </div>
      )}

      <!-- Author bar -->
      <div
        class="flex flex-wrap items-center justify-between gap-3 py-4"
        style="border-top: 1px solid var(--color-border-soft); border-bottom: 1px solid var(--color-border-soft);"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-medium" style="background: var(--color-accent-light); color: var(--color-accent-dark);" aria-hidden="true">
            {(data.author ?? SITE.author.name).charAt(0)}
          </div>
          <div>
            <p class="text-sm font-medium" style="color: var(--color-heading);">{data.author ?? SITE.author.name}</p>
            <p class="text-xs" style="color: var(--color-text-faint);">
              <time datetime={formatDateISO(data.pubDate)}>{formatDate(data.pubDate)}</time>
              {data.updatedDate && (
                <> · Atualizado em <time datetime={formatDateISO(data.updatedDate)}>{formatDate(data.updatedDate)}</time></>
              )}
            </p>
          </div>
        </div>
        <span class="text-xs flex items-center gap-1.5" style="color: var(--color-text-faint);">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
          </svg>
          {minutes} min de leitura
        </span>
      </div>
    </header>

    <!-- Hero image -->
    {data.heroImage && (
      <div class="container-wide mb-12">
        <figure class="rounded-2xl overflow-hidden" style="aspect-ratio: 16/7;">
          <img
            src={data.heroImage as unknown as string}
            alt={data.heroImageAlt ?? data.title}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            width="1400"
            height="612"
          />
        </figure>
      </div>
    )}

    <!-- Ad before content -->
    <div class="container-narrow mb-8">
      <AdUnit slot="GUIDE_TOP" format="auto" />
    </div>

    <!-- Guide content -->
    <div class="container-narrow">
      <div class="prose-stradello prose prose-lg dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>

    <!-- Tags -->
    {data.tags.length > 0 && (
      <div class="container-narrow mt-12 pt-8" style="border-top: 1px solid var(--color-border-soft);">
        <div class="flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="badge badge-stone hover:opacity-80 transition-opacity">#{tag}</a>
          ))}
        </div>
      </div>
    )}

    <!-- Newsletter -->
    <div class="container-narrow mt-12">
      <NewsletterBanner variant="inline" />
    </div>
  </article>

  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('article');
    if (progressBar && article) {
      window.addEventListener('scroll', () => {
        const progress = Math.min(
          Math.max((window.scrollY - article.offsetTop) / (article.offsetHeight - window.innerHeight) * 100, 0),
          100
        );
        progressBar.style.width = `${progress}%`;
      }, { passive: true });
    }
  </script>
</BaseLayout>
