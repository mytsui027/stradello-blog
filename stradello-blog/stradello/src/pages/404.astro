---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página não encontrada"
  description="A página que você procura não existe ou foi movida."
  noindex={true}
>
  <section class="section-gap min-h-[60vh] flex items-center">
    <div class="container-site text-center">
      <div class="max-w-lg mx-auto">
        <!-- Decorative number -->
        <p
          class="font-display font-light mb-4"
          style="font-size: clamp(6rem, 4rem + 8vw, 12rem); color: var(--color-border); line-height: 1; letter-spacing: -0.05em;"
          aria-hidden="true"
        >
          404
        </p>

        <h1 class="font-display text-2xl font-medium mb-3" style="color: var(--color-heading); letter-spacing: -0.02em;">
          Esse caminho não existe
        </h1>
        <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
          Parece que você encontrou uma viela sem saída. Talvez a página tenha sido movida, ou o endereço tenha um erro. Que tal explorar outros caminhos?
        </p>

        <div class="flex flex-wrap justify-center gap-3">
          <a href="/" class="btn-primary">Voltar ao início</a>
          <a href="/blog" class="btn-outline">Ver artigos</a>
          <a href="/busca" class="btn-outline">Buscar</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
