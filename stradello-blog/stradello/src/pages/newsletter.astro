---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter"
  description="Assine a newsletter do Stradello e receba guias autorais de slow travel, destinos quietos e reflexões sobre viajar com calma — sem spam, sem pressa."
>
  <section class="section-gap">
    <div class="container-site">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Icon -->
        <div
          class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-8"
          style="background: color-mix(in srgb, var(--color-accent) 12%, transparent);"
          aria-hidden="true"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>

        <p class="section-label mb-4">Newsletter</p>
        <h1
          class="section-title mb-5"
          style="font-size: clamp(2.25rem, 1.5rem + 2.5vw, 4rem);"
        >
          Viajar devagar começa<br />
          com uma boa carta.
        </h1>
        <p class="text-base leading-relaxed mb-10 max-w-lg mx-auto" style="color: var(--color-text-muted);">
          Uma carta, não um boletim. Destinos quietos, reflexões sobre slow travel e guias autorais enviados com calma — sem spam, sem pressa, só o essencial.
        </p>

        <!-- Form -->
        <form
          id="newsletter-form"
          class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-6"
          aria-label="Formulário de inscrição"
          novalidate
        >
          <div class="flex-1">
            <label for="nl-email" class="sr-only">Seu endereço de e-mail</label>
            <input
              id="nl-email"
              type="email"
              name="email"
              placeholder="seu@email.com"
              required
              class="w-full px-5 py-3.5 rounded-full text-sm border outline-none transition-all duration-200 focus:ring-2"
              style="
                background: var(--color-bg-card);
                border-color: var(--color-border);
                color: var(--color-text);
                --tw-ring-color: var(--color-accent);
              "
              aria-required="true"
            />
          </div>
          <button type="submit" class="btn-accent whitespace-nowrap" id="nl-submit">
            Assinar gratuitamente
          </button>
        </form>

        <!-- Success state (hidden) -->
        <div
          id="nl-success"
          class="hidden text-center p-6 rounded-xl mb-6"
          style="background: color-mix(in srgb, var(--color-accent) 10%, transparent);"
          role="alert"
          aria-live="polite"
        >
          <p class="font-display text-xl font-medium mb-1" style="color: var(--color-accent-dark);">
            ✓ Você está dentro.
          </p>
          <p class="text-sm" style="color: var(--color-text-muted);">
            Fique de olho na sua caixa de entrada. A primeira carta chega em breve.
          </p>
        </div>

        <p class="text-xs" style="color: var(--color-text-faint);">
          Sem spam. Cancele quando quiser com um clique.
        </p>
      </div>

      <!-- What to expect -->
      <div class="mt-20 max-w-3xl mx-auto">
        <div class="divider mb-12" aria-hidden="true"></div>
        <h2 class="font-display text-2xl font-medium text-center mb-10" style="color: var(--color-heading); letter-spacing: -0.02em;">
          O que você vai receber
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {[
            {
              icon: '🗺️',
              title: 'Guias de destinos',
              text: 'Roteiros autorais para lugares tranquilos — escritos por quem foi e ficou o tempo suficiente para realmente conhecer.',
            },
            {
              icon: '✍️',
              title: 'Reflexões sobre viajar',
              text: 'Textos sobre slow travel, introversão em viagem, turismo consciente e por que viajar devagar muda tudo.',
            },
            {
              icon: '💡',
              title: 'Dicas práticas',
              text: 'Hotéis quietos, cafeterias escondidas, como organizar uma viagem solo sem estresse e muito mais.',
            },
          ].map((item) => (
            <div class="text-center p-6 rounded-xl" style="background: var(--color-bg-alt);">
              <span class="text-3xl block mb-3" aria-hidden="true">{item.icon}</span>
              <h3 class="font-display font-medium text-base mb-2" style="color: var(--color-heading);">
                {item.title}
              </h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {item.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('newsletter-form');
  const successEl = document.getElementById('nl-success');
  const submitBtn = document.getElementById('nl-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form as HTMLFormElement).querySelector<HTMLInputElement>('#nl-email')?.value;
    if (!email) return;

    submitBtn!.textContent = 'Enviando…';
    submitBtn!.setAttribute('disabled', 'true');

    // TODO: Integrate with your email provider (ConvertKit, Brevo, Mailchimp, etc.)
    // Simulating success for now
    await new Promise((r) => setTimeout(r, 800));

    form.classList.add('hidden');
    successEl?.classList.remove('hidden');
  });
</script>
