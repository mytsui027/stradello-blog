---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { sortByDate } from '../../utils/helpers';
import { POSTS_PER_PAGE, SITE } from '../../config/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = sortByDate(allPosts);

const currentPage = 1;
const totalPosts = sorted.length;
const totalPages = Math.max(Math.ceil(totalPosts / POSTS_PER_PAGE), 1);
const posts = sorted.slice(0, POSTS_PER_PAGE);

const title = 'Blog';
const description =
  'Artigos sobre slow travel, viagens solo, destinos tranquilos e experiências autênticas para quem prefere viajar com calma e intenção.';
---

<BaseLayout title={title} description={description} canonicalUrl={`${SITE.url}/blog`}>
  <section class="section-gap pb-10">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="section-label mb-3">Blog</p>
        <h1
          class="section-title mb-4"
          style="font-size: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);"
        >
          Histórias para viajar sem pressa
        </h1>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Slow travel, destinos quietos e experiências autênticas para quem prefere
          profundidade ao excesso.
        </p>
      </div>
    </div>
  </section>

  <section class="container-site pb-20" aria-label="Lista de artigos">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => (
          <div class="reveal" style={`animation-delay: ${(i % 6) * 0.08}s`}>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              pubDate={post.data.pubDate}
              category={post.data.category}
              categorySlug={post.data.category.toLowerCase().replace(/\s+/g, '-')}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              author={post.data.author}
              featured={post.data.featured}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-24">
        <div class="text-5xl mb-6" aria-hidden="true">🌿</div>
        <h2 class="font-display text-2xl font-light mb-3" style="color: var(--color-text-muted);">
          Em construção com calma
        </h2>
        <p class="text-sm mb-8" style="color: var(--color-text-faint);">
          Os primeiros artigos estão sendo escritos. Assine a newsletter para ser avisado.
        </p>
        <a href="/newsletter" class="btn-accent">Assinar newsletter</a>
      </div>
    )}

    {totalPages > 1 && (
      <nav
        class="flex items-center justify-center gap-2 mt-14"
        aria-label="Paginação"
      >
        <div class="flex items-center gap-1">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={page === 1 ? '/blog' : `/blog/${page}`}
              class:list={[
                'w-9 h-9 rounded-lg flex items-center justify-center text-sm font-medium transition-all duration-200',
                page === currentPage ? 'text-white' : 'hover:bg-surface-alt',
              ]}
              style={page === currentPage ? 'background: var(--color-accent);' : 'color: var(--color-text-muted);'}
              aria-label={`Página ${page}`}
              aria-current={page === currentPage ? 'page' : undefined}
            >
              {page}
            </a>
          ))}
        </div>

        <a
          href="/blog/2"
          class="btn-outline px-5 py-2.5 text-sm"
          aria-label="Próxima página"
        >
          Próxima →
        </a>
      </nav>
    )}
  </section>
</BaseLayout>
