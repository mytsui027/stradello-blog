---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, SITE } from '../../config/site';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Categorias do Stradello',
  url: `${SITE.url}/categorias`,
  description:
    'Explore as categorias editoriais do Stradello e encontre o estilo de viagem que combina com você.',
};
---

<BaseLayout
  title="Categorias"
  description="Descubra as categorias do Stradello e encontre destinos e experiências no seu ritmo."
  canonicalUrl={`${SITE.url}/categorias`}
  structuredData={collectionSchema}
>
  <section class="section-gap" aria-labelledby="categories-heading">
    <div class="container-site">
      <div class="flex items-end justify-between gap-4 mb-10 md:mb-12">
        <div>
          <p class="section-label mb-2">Explore por tema</p>
          <h1 id="categories-heading" class="section-title text-balance">
            Que tipo de viagem é a sua?
          </h1>
        </div>
        <a href="/blog" class="btn-outline hidden sm:inline-flex">
          Ver todas →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4">
        {CATEGORIES.map((category, index) => (
          <a
            href={`/categorias/${category.slug}`}
            class="reveal group flex flex-col items-center justify-center gap-3 p-5 md:p-6 rounded-xl border transition-all duration-300 text-center"
            style={`
              border-color: var(--color-border-soft);
              background: var(--color-bg-card);
              animation-delay: ${index * 0.06}s;
            `}
            aria-label={`Ver artigos da categoria ${category.name}`}
          >
            <span class="text-2xl transition-transform duration-300 group-hover:scale-125" aria-hidden="true">
              {category.emoji}
            </span>
            <span
              class="text-xs sm:text-sm font-medium leading-tight transition-colors duration-200 group-hover:text-accent"
              style="color: var(--color-text-muted);"
            >
              {category.name}
            </span>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center sm:hidden">
        <a href="/blog" class="btn-outline">Ver todas →</a>
      </div>
    </div>
  </section>
</BaseLayout>