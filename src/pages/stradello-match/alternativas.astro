---
// ================================================================
// Stradello Match — Alternativas Page (Results)
// ================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { getAllDestinations } from '../../utils/matchAlgorithm';
import DestinationCard from '../../components/stradello-match/DestinationCard.astro';
import { generateBreadcrumbSchema } from '../../utils/helpers';
import { getCollection } from 'astro:content';

// Get all destinations as fallback
const allDestinations = getAllDestinations();

// Note: In a real implementation, we would get responses from URL params or client-side storage
// For now, we'll show all destinations sorted by a default score
const defaultResults = allDestinations.map((dest) => ({
  destination: dest,
  score: 70,
  compatibility: 'bom' as const,
})).slice(0, 3);

const defaultAlternatives = allDestinations.slice(3, 8).map((dest) => ({
  destination: dest,
  score: 65,
  compatibility: 'muito-bom' as const,
}));

// Get similar destinations (based on top match)
const topMatch = defaultResults[0]?.destination;
const similarDestinations = topMatch?.similares 
  ? allDestinations.filter((d) => topMatch.similares.includes(d.slug)).slice(0, 3)
  : allDestinations.slice(8, 11);

// Get related blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((post) => {
    const postCategory = post.data.category?.toLowerCase() || '';
    const relevantCategories = ['slow travel', 'natureza', 'viagens solo', 'lugares para desacelerar', 'experiências locais'];
    return relevantCategories.some((cat) => postCategory.includes(cat));
  })
  .slice(0, 3);

// SEO
const title = 'Seus Destinos — Stradello Match';
const description = 'Veja os destinos que mais combinam com você baseados nas suas respostas do quiz. Descubra alternativas autênticas fora do óbvio.';
const canonicalUrl = `${SITE.url}/stradello-match/alternativas`;

// Schema.org
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Início', url: SITE.url },
  { name: 'Stradello Match', url: `${SITE.url}/stradello-match` },
  { name: 'Quiz', url: `${SITE.url}/stradello-match/quiz` },
  { name: 'Resultados', url: canonicalUrl },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  structuredData={breadcrumbSchema}
>
  <!-- Header -->
  <section class="section-gap">
    <div class="container-site">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <a href="/stradello-match" class="inline-flex items-center gap-2 text-sm font-medium transition-colors duration-200 mb-6" style="color: var(--color-text-muted);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Voltar para Stradello Match
        </a>

        <p class="section-label mb-3">Stradello Match</p>
        <h1 class="section-title mb-4">
          Seus destinos ideais
        </h1>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Encontramos destinos que combinam com seu estilo de viagem.
        </p>

        <!-- Action buttons -->
        <div class="flex flex-wrap gap-3 justify-center mt-6">
          <a href="/stradello-match/quiz" class="btn-outline">
            Refazer quiz
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Matches -->
  <section class="section-gap" id="top-matches-section">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <p class="section-label mb-3">Stradello Match</p>
        <h2 class="section-title mb-4">Top recomendações para você</h2>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Estes são os destinos que mais se alinham com suas preferências de viagem.
        </p>
      </div>

      <div id="top-matches-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fallback content (will be replaced by client-side script) -->
        {defaultResults.map((result, index) => (
          <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
            <DestinationCard
              slug={result.destination.slug}
              nome={result.destination.nome}
              estado={result.destination.estado}
              pais={result.destination.pais}
              descricao={result.destination.descricao}
              imagem={result.destination.imagem}
              score={result.score}
              compatibility={result.compatibility}
              showScore={true}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Alternatives -->
  <section class="section-gap" style="background: var(--color-bg-alt);" id="alternatives-section">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <p class="section-label mb-3">Stradello Match</p>
        <h2 class="section-title mb-4">Alternativas fora do óbvio</h2>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Destinos que talvez você não tenha considerado, mas que podem ser perfeitos para você.
        </p>
      </div>

      <div id="alternatives-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fallback content (will be replaced by client-side script) -->
        {defaultAlternatives.map((result, index) => (
          <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
            <DestinationCard
              slug={result.destination.slug}
              nome={result.destination.nome}
              estado={result.destination.estado}
              pais={result.destination.pais}
              descricao={result.destination.descricao}
              imagem={result.destination.imagem}
              score={result.score}
              compatibility={result.compatibility}
              showScore={true}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Similar destinations -->
  <section class="section-gap" id="similar-section">
    <div class="container-site">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label mb-3">Destinos semelhantes</p>
          <h2 class="section-title">
            Você também pode gostar
          </h2>
        </div>
      </div>

      <div id="similar-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fallback content (will be replaced by client-side script) -->
        {similarDestinations.map((dest, index) => (
          <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
            <DestinationCard
              slug={dest.slug}
              nome={dest.nome}
              estado={dest.estado}
              pais={dest.pais}
              descricao={dest.descricao}
              imagem={dest.imagem}
              showScore={false}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related blog posts -->
  {relatedPosts.length > 0 && (
    <section class="section-gap" style="background: var(--color-bg-alt);">
      <div class="container-site">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="section-label mb-3">Conteúdo relacionado</p>
            <h2 class="section-title">
              Artigos do Stradello
            </h2>
          </div>
          <a href="/blog" class="btn-outline hidden sm:inline-flex">
            Ver todos →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedPosts.map((post, index) => (
            <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
              <a href={`/blog/${post.slug}`} class="block group">
                <article class="rounded-xl overflow-hidden border transition-all duration-300 hover:shadow-lg" style="border-color: var(--color-border); background: var(--color-bg-card);">
                  {post.data.heroImage && (
                    <div class="aspect-[4/3] overflow-hidden">
                      <img
                        src={post.data.heroImage as unknown as string}
                        alt={post.data.heroImageAlt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        width="400"
                        height="300"
                      />
                    </div>
                  )}
                  <div class="p-5">
                    <span class="text-xs mb-2 block" style="color: var(--color-text-faint);">
                      {post.data.category}
                    </span>
                    <h3 class="font-display font-semibold text-base mb-2 leading-tight" style="color: var(--color-heading);">
                      {post.data.title}
                    </h3>
                    <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-muted);">
                      {post.data.description}
                    </p>
                  </div>
                </article>
              </a>
            </div>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog" class="btn-outline">
            Ver todos os artigos →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section-gap">
    <div class="container-site">
      <div class="max-w-2xl mx-auto text-center">
        <div class="rounded-2xl p-8 md:p-12 border" style="border-color: var(--color-border); background: var(--color-bg-card);">
          <div class="text-4xl mb-4" aria-hidden="true">✨</div>
          <h2 class="font-display text-2xl font-medium mb-4" style="color: var(--color-heading); letter-spacing: -0.02em;">
            Gostou das recomendações?
          </h2>
          <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted);">
            Explore nossos guias detalhados de destinos e descubra ainda mais lugares para viajar devagar.
          </p>
          <a href="/guias" class="btn-primary">
            Ver guias de destinos →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side script to calculate real matches and update DOM -->
  <script define:vars={{ allDestinations }}>
    const STORAGE_KEY = 'stradello-match-responses';

    // Get compatibility label based on score
    function getCompatibilityLabel(score) {
      if (score >= 80) return 'excelente';
      if (score >= 65) return 'muito-bom';
      if (score >= 50) return 'bom';
      return 'moderado';
    }

    // Get compatibility label text
    function getCompatibilityLabelText(compatibility) {
      const labels = {
        'excelente': 'Excelente compatibilidade',
        'muito-bom': 'Muito boa compatibilidade',
        'bom': 'Boa compatibilidade',
        'moderado': 'Compatibilidade moderada',
      };
      return labels[compatibility] || compatibility;
    }

    // Generate destination card HTML
    function generateDestinationCardHTML(dest, score, showScore) {
      const compatibility = getCompatibilityLabel(score);
      const compatibilityText = getCompatibilityLabelText(compatibility);
      
      return `
        <div class="reveal">
          <article class="group relative rounded-xl overflow-hidden border transition-all duration-300 hover:shadow-lg" style="border-color: var(--color-border); background: var(--color-bg-card);">
            <a href="/stradello-match/destino/${dest.slug}" class="block">
              <div class="relative aspect-[4/3] overflow-hidden">
                ${dest.imagem ? `
                  <img
                    src="${dest.imagem}"
                    alt="${dest.nome}"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    width="400"
                    height="300"
                  />
                ` : `
                  <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-bg-alt) 0%, color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)) 100%);">
                    <svg width="48" height="48" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                      <path d="M14 3C14 3 6 8 6 16C6 20.4183 9.58172 24 14 24C18.4183 24 22 20.4183 22 16C22 8 14 3 14 3Z" fill="var(--color-accent)" opacity="0.4" />
                    </svg>
                  </div>
                `}
                ${showScore ? `
                  <div class="absolute top-3 right-3 px-3 py-1.5 rounded-full text-xs font-medium" style="background: var(--color-bg); backdrop-filter: blur(8px);">
                    <span style="color: var(--color-accent);">${Math.round(score)}% compatível</span>
                  </div>
                ` : ''}
              </div>
            </a>
            <div class="p-5">
              ${showScore ? `
                <div class="mb-3">
                  <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium" style="background: var(--color-bg-alt); color: var(--color-accent);">
                    ${compatibilityText}
                  </span>
                </div>
              ` : ''}
              <p class="text-xs mb-1" style="color: var(--color-text-faint);">
                ${dest.estado}, ${dest.pais}
              </p>
              <h3 class="font-display font-semibold text-base mb-2 leading-tight" style="color: var(--color-heading); letter-spacing: -0.01em;">
                <a href="/stradello-match/destino/${dest.slug}" class="transition-colors duration-200 hover:text-accent">
                  ${dest.nome}
                </a>
              </h3>
              <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-muted);">
                ${dest.descricao}
              </p>
            </div>
          </article>
        </div>
      `;
    }

    // Calculate matches based on stored responses
    function calculateClientSideMatches() {
      const responses = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      
      if (Object.keys(responses).length === 0) {
        console.log('No responses stored, showing default results');
        return;
      }

      console.log('Calculating matches for responses:', responses);

      // Scoring algorithm (same as server-side matchAlgorithm.ts)
      const scoredDestinations = allDestinations.map(dest => {
        let totalScore = 0;
        let maxScore = 0;

        // Travel companions
        if (responses.travel_companions) {
          const key = responses.travel_companions === 'amigos' ? 'familia' : responses.travel_companions;
          totalScore += (dest.pontuacoes[key] || 0) * 1.2;
          maxScore += 10 * 1.2;
        }

        // Destination type
        if (responses.destination_type) {
          const key = responses.destination_type === 'serra' ? 'frio' : 
                     responses.destination_type === 'praia' ? 'calor' : 
                     responses.destination_type === 'cidade-historica' ? 'tranquilidade' : 
                     responses.destination_type === 'natureza' ? 'natureza' : 'tranquilidade';
          totalScore += (dest.pontuacoes[key] || 0) * 1.5;
          maxScore += 10 * 1.5;
        }

        // Cafes
        if (responses.cafes_restaurants) {
          const weight = responses.cafes_restaurants === 'sim' ? 1 : responses.cafes_restaurants === 'moderado' ? 0.7 : 0.4;
          totalScore += (dest.pontuacoes.cafes || 0) * 0.8 * weight;
          maxScore += 10 * 0.8;
        }

        // Tranquility
        if (responses.tranquility) {
          const weight = responses.tranquility === 'sim' ? 1 : responses.tranquility === 'moderado' ? 0.7 : 0.4;
          totalScore += (dest.pontuacoes.tranquilidade || 0) * 1.3 * weight;
          maxScore += 10 * 1.3;
        }

        // Temperature
        if (responses.temperature) {
          const key = responses.temperature === 'morno' ? 'frio' : responses.temperature;
          totalScore += (dest.pontuacoes[key] || 0) * 1.4;
          maxScore += 10 * 1.4;
        }

        // Accommodation
        if (responses.accommodation) {
          const key = responses.accommodation === 'hotel' ? 'tranquilidade' : responses.accommodation;
          totalScore += (dest.pontuacoes[key] || 0) * 1.0;
          maxScore += 10 * 1.0;
        }

        // Local experiences
        if (responses.local_experiences) {
          const weight = responses.local_experiences === 'sim' ? 1 : responses.local_experiences === 'moderado' ? 0.7 : 0.4;
          totalScore += (dest.pontuacoes.experienciasLocais || 0) * 1.1 * weight;
          maxScore += 10 * 1.1;
        }

        // Remote work
        if (responses.remote_work) {
          const weight = responses.remote_work === 'sim' ? 1 : responses.remote_work === 'as-vezes' ? 0.7 : 0.4;
          totalScore += (dest.pontuacoes.workation || 0) * 0.9 * weight;
          maxScore += 10 * 0.9;
        }

        // Budget
        if (responses.budget) {
          totalScore += (dest.pontuacoes[responses.budget] || 0) * 1.0;
          maxScore += 10 * 1.0;
        }

        const score = maxScore > 0 ? (totalScore / maxScore) * 100 : 0;
        return { ...dest, score };
      });

      // Sort by score
      scoredDestinations.sort((a, b) => b.score - a.score);

      console.log('Top 3 matches:', scoredDestinations.slice(0, 3).map(d => ({ nome: d.nome, score: d.score })));

      // Update DOM with real results
      updateDOMWithResults(scoredDestinations);
    }

    // Update DOM sections with calculated results
    function updateDOMWithResults(scoredDestinations) {
      // Update top matches (first 3)
      const topMatchesContainer = document.getElementById('top-matches-container');
      if (topMatchesContainer) {
        const topMatches = scoredDestinations.slice(0, 3);
        topMatchesContainer.innerHTML = topMatches.map((dest, index) => 
          generateDestinationCardHTML(dest, dest.score, true)
        ).join('');
        
        // Re-initialize reveal animations
        topMatchesContainer.querySelectorAll('.reveal').forEach((el, index) => {
          el.style.animationDelay = `${index * 0.1}s`;
        });
      }

      // Update alternatives (next 5 with score >= 50)
      const alternativesContainer = document.getElementById('alternatives-container');
      if (alternativesContainer) {
        const alternatives = scoredDestinations.slice(3).filter(d => d.score >= 50).slice(0, 5);
        alternativesContainer.innerHTML = alternatives.map((dest, index) => 
          generateDestinationCardHTML(dest, dest.score, true)
        ).join('');
        
        // Re-initialize reveal animations
        alternativesContainer.querySelectorAll('.reveal').forEach((el, index) => {
          el.style.animationDelay = `${index * 0.1}s`;
        });
      }

      // Update similar destinations (based on top match)
      const similarContainer = document.getElementById('similar-container');
      if (similarContainer) {
        const topMatch = scoredDestinations[0];
        if (topMatch && topMatch.similares && topMatch.similares.length > 0) {
          const similarDestinations = allDestinations.filter(d => 
            topMatch.similares.includes(d.slug)
          ).slice(0, 3);
          
          similarContainer.innerHTML = similarDestinations.map((dest, index) => 
            generateDestinationCardHTML(dest, 0, false)
          ).join('');
          
          // Re-initialize reveal animations
          similarContainer.querySelectorAll('.reveal').forEach((el, index) => {
            el.style.animationDelay = `${index * 0.1}s`;
          });
        }
      }

      // Re-initialize scroll reveal observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    }

    // Run on page load
    document.addEventListener('DOMContentLoaded', calculateClientSideMatches);
  </script>
</BaseLayout>
