---
// ================================================================
// Stradello Match — Destination Detail Page
// ================================================================

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import { getDestinationBySlug, getAlternativeDestinations, getAllDestinations } from '../../../utils/matchAlgorithm';
import DestinationCard from '../../../components/stradello-match/DestinationCard.astro';
import { generateBreadcrumbSchema } from '../../../utils/helpers';
import { getCollection } from 'astro:content';

// Generate static paths for all destinations
export async function getStaticPaths() {
  const allDestinations = getAllDestinations();
  return allDestinations.map((destination) => ({
    params: { slug: destination.slug },
  }));
}

// Get destination from slug
const { slug } = Astro.params;
const destination = getDestinationBySlug(slug);

// Handle 404
if (!destination) {
  return Astro.redirect('/404');
}

// Get alternative destinations
const alternatives = getAlternativeDestinations(slug);

// Get similar destinations
const similarDestinations = getAllDestinations().filter((d) =>
  destination.similares?.includes(d.slug)
).slice(0, 3);

// Get related blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((post) => {
    const postCategory = post.data.category?.toLowerCase() || '';
    const destinationCategories = destination.categorias.map((c) => c.toLowerCase());
    return destinationCategories.some((cat) => postCategory.includes(cat));
  })
  .slice(0, 3);

// SEO
const title = `${destination.nome} — Stradello Match`;
const description = `${destination.descricao} Descubra mais sobre ${destination.nome}, ${destination.estado}, Brasil. Um destino perfeito para slow travel e experiências autênticas.`;
const canonicalUrl = `${SITE.url}/stradello-match/destino/${slug}`;

// Schema.org
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Início', url: SITE.url },
  { name: 'Stradello Match', url: `${SITE.url}/stradello-match` },
  { name: destination.nome, url: canonicalUrl },
]);

const touristDestinationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: destination.nome,
  description: destination.descricao,
  url: canonicalUrl,
  address: {
    '@type': 'PostalAddress',
    addressRegion: destination.estado,
    addressCountry: destination.pais,
  },
  ...(destination.imagem && {
    image: {
      '@type': 'ImageObject',
      url: destination.imagem.startsWith('http') ? destination.imagem : `${SITE.url}${destination.imagem}`,
    },
  }),
};

const structuredData = [breadcrumbSchema, touristDestinationSchema];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={destination.imagem}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="section-gap">
    <div class="container-site">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-sm" style="color: var(--color-text-muted);">
          <li>
            <a href="/stradello-match" class="transition-colors duration-200 hover:text-accent">
              Stradello Match
            </a>
          </li>
          <li aria-hidden="true" style="color: var(--color-border);">/</li>
          <li aria-current="page" style="color: var(--color-text);">
            {destination.nome}
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Image -->
        <div class="reveal">
          <div class="rounded-2xl overflow-hidden border" style="border-color: var(--color-border);">
            {destination.imagem ? (
              <img
                src={destination.imagem}
                alt={destination.nome}
                class="w-full h-auto"
                loading="eager"
                fetchpriority="high"
                width="800"
                height="600"
              />
            ) : (
              <div
                class="aspect-[4/3] flex items-center justify-center"
                style="background: linear-gradient(135deg, var(--color-bg-alt) 0%, color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)) 100%);"
              >
                <svg width="80" height="80" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                  <path d="M14 3C14 3 6 8 6 16C6 20.4183 9.58172 24 14 24C18.4183 24 22 20.4183 22 16C22 8 14 3 14 3Z" fill="var(--color-accent)" opacity="0.4" />
                </svg>
              </div>
            )}
          </div>
        </div>

        <!-- Content -->
        <div class="stagger-children">
          <!-- Location badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium mb-4" style="background: var(--color-bg-alt); color: var(--color-text-muted);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            {destination.estado}, {destination.pais}
          </div>

          <h1 class="section-title mb-4">
            {destination.nome}
          </h1>

          <p class="text-lg leading-relaxed mb-6" style="color: var(--color-text-muted);">
            {destination.descricao}
          </p>

          <!-- Categories -->
          <div class="mb-8">
            <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color: var(--color-accent);">
              Categorias
            </p>
            <div class="flex flex-wrap gap-2">
              {destination.categorias.map((category) => (
                <span class="px-3 py-1.5 rounded-full text-sm" style="background: var(--color-bg-alt); color: var(--color-text-muted);">
                  {category}
                </span>
              ))}
            </div>
          </div>

          <!-- CTA -->
          <div class="flex flex-wrap gap-3">
            <a href="/stradello-match/quiz" class="btn-primary">
              Ver se combina comigo
            </a>
            <a href="/stradello-match/alternativas" class="btn-outline">
              Ver outros destinos
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why this destination -->
  <section class="section-gap" style="background: var(--color-bg-alt);">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <p class="section-label mb-3">Sobre este destino</p>
        <h2 class="section-title mb-4">
          Por que {destination.nome}?
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Este destino se destaca por suas características únicas que combinam com viajantes que buscam experiências autênticas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {destination.uniqueReasons && destination.uniqueReasons.length > 0 ? (
          destination.uniqueReasons.map((reason, index) => (
            <div class="rounded-xl p-6 border" style="border-color: var(--color-border); background: var(--color-bg-card);">
              <div class="text-2xl mb-3" aria-hidden="true">
                {index === 0 && '✨'}
                {index === 1 && '🌟'}
                {index === 2 && '💎'}
                {index === 3 && '🎯'}
                {index === 4 && '🏆'}
              </div>
              <h3 class="font-display font-semibold text-base mb-2" style="color: var(--color-heading);">
                {reason}
              </h3>
            </div>
          ))
        ) : (
          <div class="col-span-full text-center py-8" style="color: var(--color-text-muted);">
            Informações sobre este destino em breve.
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Best time to visit -->
  <section class="section-gap">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <p class="section-label mb-3">Planejamento</p>
        <h2 class="section-title mb-4">
          Melhor época para visitar
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
          Conheça as características climáticas e eventos sazonais para planejar sua viagem no momento ideal.
        </p>
      </div>

      {destination.seasonTitle && destination.seasonDescription && destination.seasonPeriod ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="rounded-xl p-6 border md:col-span-2 lg:col-span-4" style="border-color: var(--color-border); background: var(--color-bg-card);">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <div class="text-2xl mb-3" aria-hidden="true">📅</div>
                <h3 class="font-display font-semibold text-lg mb-2" style="color: var(--color-heading);">
                  {destination.seasonTitle}
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                  {destination.seasonDescription}
                </p>
              </div>
              <div class="flex-shrink-0">
                <span class="text-sm px-4 py-2 rounded-full font-medium" style="background: var(--color-bg-alt); color: var(--color-accent);">
                  {destination.seasonPeriod}
                </span>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="text-center py-8" style="color: var(--color-text-muted);">
          Informações sobre a melhor época para visitar em breve.
        </div>
      )}
    </div>
  </section>


  <!-- Similar destinations -->
  {similarDestinations.length > 0 && (
    <section class="section-gap">
      <div class="container-site">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="section-label mb-3">Destinos semelhantes</p>
            <h2 class="section-title">
              Você também pode gostar
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {similarDestinations.map((dest, index) => (
            <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
              <DestinationCard
                slug={dest.slug}
                nome={dest.nome}
                estado={dest.estado}
                pais={dest.pais}
                descricao={dest.descricao}
                imagem={dest.imagem}
                showScore={false}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Alternative destinations -->
  {alternatives.length > 0 && (
    <section class="section-gap" style="background: var(--color-bg-alt);">
      <div class="container-site">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="section-label mb-3">Alternativas</p>
            <h2 class="section-title">
              Fora do óbvio
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {alternatives.map((result, index) => (
            <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
              <DestinationCard
                slug={result.destination.slug}
                nome={result.destination.nome}
                estado={result.destination.estado}
                pais={result.destination.pais}
                descricao={result.destination.descricao}
                imagem={result.destination.imagem}
                score={result.score}
                compatibility={result.compatibility}
                showScore={true}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related blog posts -->
  {relatedPosts.length > 0 && (
    <section class="section-gap">
      <div class="container-site">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="section-label mb-3">Conteúdo relacionado</p>
            <h2 class="section-title">
              Artigos do Stradello
            </h2>
          </div>
          <a href="/blog" class="btn-outline hidden sm:inline-flex">
            Ver todos →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedPosts.map((post, index) => (
            <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
              <a href={`/blog/${post.slug}`} class="block group">
                <article class="rounded-xl overflow-hidden border transition-all duration-300 hover:shadow-lg" style="border-color: var(--color-border); background: var(--color-bg-card);">
                  {post.data.heroImage && (
                    <div class="aspect-[4/3] overflow-hidden">
                      <img
                        src={post.data.heroImage as unknown as string}
                        alt={post.data.heroImageAlt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        width="400"
                        height="300"
                      />
                    </div>
                  )}
                  <div class="p-5">
                    <span class="text-xs mb-2 block" style="color: var(--color-text-faint);">
                      {post.data.category}
                    </span>
                    <h3 class="font-display font-semibold text-base mb-2 leading-tight" style="color: var(--color-heading);">
                      {post.data.title}
                    </h3>
                    <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-muted);">
                      {post.data.description}
                    </p>
                  </div>
                </article>
              </a>
            </div>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog" class="btn-outline">
            Ver todos os artigos →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section-gap">
    <div class="container-site">
      <div class="max-w-2xl mx-auto text-center">
        <div class="rounded-2xl p-8 md:p-12 border" style="border-color: var(--color-border); background: var(--color-bg-card);">
          <div class="text-4xl mb-4" aria-hidden="true">🧭</div>
          <h2 class="font-display text-2xl font-medium mb-4" style="color: var(--color-heading); letter-spacing: -0.02em;">
            {destination.nome} combina com você?
          </h2>
          <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted);">
            Responda ao quiz e descubra outros destinos que podem ser perfeitos para seu estilo de viagem.
          </p>
          <a href="/stradello-match/quiz" class="btn-primary">
            Fazer o quiz →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
