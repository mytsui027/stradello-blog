---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Contato"
  description="Entre em contato com o Stradello para parcerias, sugestões de pauta, colaborações editoriais."
>
  <section class="section-gap">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">

        <!-- Left: info -->
        <div>
          <p class="section-label mb-4">Contato</p>
          <h1 class="section-title mb-5" style="font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);">
            Vamos conversar.
          </h1>
          <p class="text-base leading-relaxed mb-10" style="color: var(--color-text-muted);">
            Gostou de algum artigo? Tem um destino que merecia ser abordado? Quer propor uma parceria editorial ou tem uma história de slow travel para compartilhar? Escreva para a gente.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">E-mail</p>
                <a href={`mailto:${SITE.author.email}`} class="text-sm text-accent hover:underline" style="color: var(--color-accent);">
                  {SITE.author.email}
                </a>
              </div>
            </div>

            {SITE.social.instagram && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">Instagram</p>
                  <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="text-sm" style="color: var(--color-accent);">
                    @stradello.blog
                  </a>
                </div>
              </div>
            )}

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">Tempo de resposta</p>
                <p class="text-sm" style="color: var(--color-text-muted);">Respondemos em até 5 dias úteis.</p>
              </div>
            </div>
          </div>

          <!-- Topics -->
          <div class="mt-10 p-6 rounded-xl" style="background: var(--color-bg-alt);">
            <p class="text-xs font-medium uppercase tracking-widest mb-4" style="color: var(--color-accent);">Podemos conversar sobre</p>
            <ul class="space-y-2 text-sm" style="color: var(--color-text-muted);">
              {[
                'Parcerias editoriais e colaborações',
                'Sugestões de destinos e pautas',
                'Hospedagens, glamping e turismo local',
                'Afiliados e parcerias comerciais alinhadas',
                'Press trips e viagens de imprensa',
                'Feedback sobre o blog',
              ].map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full shrink-0" style="background: var(--color-accent);" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Right: form -->
        <div>
          <form
  name="contato"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  id="contact-form"
  class="space-y-5"
  novalidate
  aria-label="Formulário de contato"
>
  <input type="hidden" name="form-name" value="contato" />

  <p hidden>
    <label>
      Não preencha isso:
      <input name="bot-field" />
    </label>
  </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-name" class="block text-sm font-medium mb-1.5" style="color: var(--color-text);">
          Nome <span aria-hidden="true" style="color: var(--color-accent);">*</span>
        </label>

        <input
          id="contact-name"
          type="text"
          name="name"
          required
          autocomplete="given-name"
          class="w-full px-4 py-3 rounded-xl text-sm border outline-none transition-all duration-200 focus:ring-2"
          style="background: var(--color-bg-card); border-color: var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-accent);"
          aria-required="true"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-sm font-medium mb-1.5" style="color: var(--color-text);">
          E-mail <span aria-hidden="true" style="color: var(--color-accent);">*</span>
        </label>

        <input
          id="contact-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          class="w-full px-4 py-3 rounded-xl text-sm border outline-none transition-all duration-200 focus:ring-2"
          style="background: var(--color-bg-card); border-color: var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-accent);"
          aria-required="true"
        />
      </div>
    </div>

            <div>
              <label for="contact-subject" class="block text-sm font-medium mb-1.5" style="color: var(--color-text);">
                Assunto
              </label>
              <select
                id="contact-subject"
                name="subject"
                class="w-full px-4 py-3 rounded-xl text-sm border outline-none transition-all duration-200 focus:ring-2"
                style="background: var(--color-bg-card); border-color: var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-accent);"
              >
                <option value="">Selecione um assunto…</option>
                <option value="parceria">Parceria editorial</option>
                <option value="sugestao">Sugestão de pauta</option>
                <option value="hospedagem">Hospedagem / Glamping</option>
                <option value="afiliado">Afiliados / Comercial</option>
                <option value="press">Press trip (viagem de imprensa)</option>
                <option value="feedback">Feedback</option>
                <option value="outro">Outro</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium mb-1.5" style="color: var(--color-text);">
                Mensagem <span aria-hidden="true" style="color: var(--color-accent);">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows={6}
                required
                placeholder="Conte um pouco mais sobre sua mensagem…"
                class="w-full px-4 py-3 rounded-xl text-sm border outline-none transition-all duration-200 focus:ring-2 resize-y"
                style="background: var(--color-bg-card); border-color: var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-accent);"
                aria-required="true"
              ></textarea>
            </div>

            <button type="submit" class="btn-accent w-full justify-center" id="contact-submit">
              Enviar mensagem
            </button>
          </form>

          <!-- Success -->
          <div
            id="contact-success"
            class="hidden p-8 rounded-xl text-center"
            style="background: color-mix(in srgb, var(--color-accent) 10%, transparent);"
            role="alert"
            aria-live="polite"
          >
            <p class="text-3xl mb-3" aria-hidden="true">✓</p>
            <p class="font-display text-xl font-medium mb-2" style="color: var(--color-accent-dark);">Mensagem recebida.</p>
            <p class="text-sm" style="color: var(--color-text-muted);">Obrigado por escrever. Respondemos em até 5 dias úteis — com calma e cuidado.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
