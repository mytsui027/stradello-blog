---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Contato"
  description="Entre em contato com o Stradello para parcerias, sugestões de pauta, colaborações editoriais."
>
  <section class="section-gap">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">

        <!-- Left: info -->
        <div>
          <p class="section-label mb-4">Contato</p>
          <h1 class="section-title mb-5" style="font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);">
            Vamos conversar.
          </h1>
          <p class="text-base leading-relaxed mb-10" style="color: var(--color-text-muted);">
            Gostou de algum artigo? Tem um destino que merecia ser abordado? Quer propor uma parceria editorial ou tem uma história de slow travel para compartilhar? Escreva para a gente.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">E-mail</p>
                <a href={`mailto:${SITE.author.email}`} class="text-sm text-accent hover:underline" style="color: var(--color-accent);">
                  {SITE.author.email}
                </a>
              </div>
            </div>

            {SITE.social.instagram && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">Instagram</p>
                  <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="text-sm" style="color: var(--color-accent);">
                    @stradello.blog
                  </a>
                </div>
              </div>
            )}

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-bg-alt);" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium mb-0.5" style="color: var(--color-heading);">Tempo de resposta</p>
                <p class="text-sm" style="color: var(--color-text-muted);">Respondemos em até 5 dias úteis.</p>
              </div>
            </div>
          </div>

          <!-- Topics -->
          <div class="mt-10 p-6 rounded-xl" style="background: var(--color-bg-alt);">
            <p class="text-xs font-medium uppercase tracking-widest mb-4" style="color: var(--color-accent);">Podemos conversar sobre</p>
            <ul class="space-y-2 text-sm" style="color: var(--color-text-muted);">
              {[
                'Parcerias editoriais e colaborações',
                'Sugestões de destinos e pautas',
                'Hospedagens, glamping e turismo local',
                'Afiliados e parcerias comerciais alinhadas',
                'Press trips e viagens de imprensa',
                'Feedback sobre o blog',
              ].map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full shrink-0" style="background: var(--color-accent);" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
