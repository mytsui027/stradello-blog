---
// ================================================================
// Stradello Match — Alternative Destinations Component
// ================================================================

import DestinationCard from './DestinationCard.astro';
import type { MatchResult } from '../../utils/matchAlgorithm';

interface Props {
  title: string;
  description: string;
  alternatives: MatchResult[];
}

const { title, description, alternatives } = Astro.props;
---

<section class="section-gap" style="background: var(--color-bg-alt);">
  <div class="container-site">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <p class="section-label mb-3">Fora do óbvio</p>
      <h2 class="section-title mb-4">{title}</h2>
      <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
        {description}
      </p>
    </div>

    <!-- Alternatives grid -->
    {alternatives.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {alternatives.map((result, index) => (
          <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
            <DestinationCard
              slug={result.destination.slug}
              nome={result.destination.nome}
              estado={result.destination.estado}
              pais={result.destination.pais}
              descricao={result.destination.descricao}
              imagem={result.destination.imagem}
              score={result.score}
              compatibility={result.compatibility}
              showScore={true}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-sm" style="color: var(--color-text-muted);">
          Mais alternativas serão adicionadas em breve.
        </p>
      </div>
    )}
  </div>
</section>
