---
// ================================================================
// Stradello Match — Quiz Component
// ================================================================

import { quizQuestions, type QuizResponses } from '../../utils/matchAlgorithm';

interface Props {
  currentQuestion?: number;
  responses?: QuizResponses;
}

const { currentQuestion = 0, responses = {} } = Astro.props;

const question = quizQuestions[currentQuestion];
const progress = ((currentQuestion + 1) / quizQuestions.length) * 100;
const isLastQuestion = currentQuestion === quizQuestions.length - 1;
---

<div class="max-w-2xl mx-auto">
  <!-- Progress bar -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium" style="color: var(--color-text-muted);">
        Pergunta {currentQuestion + 1} de {quizQuestions.length}
      </span>
      <span class="text-sm font-medium" style="color: var(--color-accent);">
        {Math.round(progress)}%
      </span>
    </div>
    <div class="h-2 rounded-full overflow-hidden" style="background: var(--color-border-soft);">
      <div
        class="h-full rounded-full transition-all duration-500 ease-out"
        style="width: {progress}%; background: var(--color-accent);"
      ></div>
    </div>
  </div>

  <!-- Question card -->
  <div class="rounded-2xl p-8 border" style="border-color: var(--color-border); background: var(--color-bg-card);">
    <h2 class="font-display text-2xl font-medium mb-6 leading-tight" style="color: var(--color-heading); letter-spacing: -0.02em;">
      {question.question}
    </h2>

    <!-- Options -->
    <div class="space-y-3">
      {question.options.map((option, index) => {
        const isSelected = responses[question.id] === option.value;
        return (
          <button
            type="button"
            data-question={question.id}
            data-value={option.value}
            data-next={isLastQuestion ? 'results' : currentQuestion + 1}
            class:list={[
              'w-full text-left px-5 py-4 rounded-xl border transition-all duration-200 text-base',
              'hover:border-accent hover:bg-surface-alt',
              isSelected ? 'border-accent bg-surface-alt' : '',
            ]}
            style={`border-color: ${isSelected ? 'var(--color-accent)' : 'var(--color-border)'};`}
          >
            <div class="flex items-center gap-3">
              <!-- Radio indicator -->
              <div class="w-5 h-5 rounded-full border flex items-center justify-center transition-all duration-200"
                style={`border-color: ${isSelected ? 'var(--color-accent)' : 'var(--color-border)'};`}
              >
                {isSelected && (
                  <div class="w-3 h-3 rounded-full" style="background: var(--color-accent);"></div>
                )}
              </div>

              <!-- Option label -->
              <span class="font-medium" style="color: var(--color-text);">
                {option.label}
              </span>
            </div>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Navigation -->
  <div class="mt-6 flex items-center justify-between">
    {currentQuestion > 0 && (
      <button
        type="button"
        data-prev={currentQuestion - 1}
        class="px-5 py-2.5 rounded-lg border transition-all duration-200 text-sm font-medium"
        style="border-color: var(--color-border); color: var(--color-text-muted);"
      >
        ← Anterior
      </button>
    )}

    <div class="flex-1"></div>

    <p class="text-xs" style="color: var(--color-text-faint);">
      {isLastQuestion ? 'Última pergunta' : 'Próximo →'}
    </p>
  </div>
</div>

<script>
  // Quiz navigation logic
  const buttons = document.querySelectorAll('button[data-question]');
  const prevButton = document.querySelector('button[data-prev]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const questionId = button.getAttribute('data-question');
      const value = button.getAttribute('data-value');
      const nextStep = button.getAttribute('data-next');

      // Store response
      const responses = JSON.parse(sessionStorage.getItem('stradello-match-responses') || '{}');
      responses[questionId] = value;
      sessionStorage.setItem('stradello-match-responses', JSON.stringify(responses));

      // Navigate
      if (nextStep === 'results') {
        window.location.href = '/stradello-match/alternativas';
      } else {
        window.location.href = `/stradello-match/quiz?question=${nextStep}`;
      }
    });
  });

  prevButton?.addEventListener('click', () => {
    const prevQuestion = prevButton.getAttribute('data-prev');
    window.location.href = `/stradello-match/quiz?question=${prevQuestion}`;
  });
</script>
