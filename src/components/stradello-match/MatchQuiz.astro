---
// ================================================================
// Stradello Match — Quiz Component
// ================================================================

import { quizQuestions, type QuizResponses } from '../../utils/matchAlgorithm';

interface Props {
  currentQuestion?: number;
}

const { currentQuestion = 0 } = Astro.props;

const question = quizQuestions[currentQuestion];
const progress = ((currentQuestion + 1) / quizQuestions.length) * 100;
const isLastQuestion = currentQuestion === quizQuestions.length - 1;
---

<div class="max-w-2xl mx-auto" id="quiz-container">
  <!-- Progress bar -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium" style="color: var(--color-text-muted);">
        Pergunta {currentQuestion + 1} de {quizQuestions.length}
      </span>
      <span class="text-sm font-medium" style="color: var(--color-accent);">
        {Math.round(progress)}%
      </span>
    </div>
    <div class="h-2 rounded-full overflow-hidden" style="background: var(--color-border-soft);">
      <div
        class="h-full rounded-full transition-all duration-500 ease-out"
        style="width: {progress}%; background: var(--color-accent);"
      ></div>
    </div>
  </div>

  <!-- Question card -->
  <div class="rounded-2xl p-8 border" style="border-color: var(--color-border); background: var(--color-bg-card);">
    <h2 class="font-display text-2xl font-medium mb-6 leading-tight" style="color: var(--color-heading); letter-spacing: -0.02em;">
      {question.question}
    </h2>

    <!-- Options form -->
    <form id="quiz-form" data-question-id={question.id} data-current-question={currentQuestion} data-is-last={isLastQuestion}>
      <div class="space-y-3">
        {question.options.map((option, index) => (
          <label class="block cursor-pointer group">
            <input
              type="radio"
              name={question.id}
              value={option.value}
              class="sr-only peer"
              required
            />
            <div class="quiz-option w-full text-left px-5 py-4 rounded-xl border transition-all duration-200 text-base"
              style="border-color: var(--color-border); background: var(--color-bg-card);"
            >
              <div class="flex items-center gap-3">
                <!-- Radio indicator -->
                <div class="quiz-radio w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all duration-200"
                  style="border-color: var(--color-border);"
                >
                  <div class="quiz-radio-dot w-3 h-3 rounded-full opacity-0 transition-opacity duration-200" style="background: var(--color-accent);"></div>
                </div>

                <!-- Option label -->
                <span class="font-medium" style="color: var(--color-text);">
                  {option.label}
                </span>
              </div>
            </div>
          </label>
        ))}
      </div>
    </form>
  </div>

  <!-- Navigation -->
  <div class="mt-6 flex items-center justify-between">
    {currentQuestion > 0 && (
      <button
        type="button"
        id="prev-button"
        data-prev={currentQuestion - 1}
        class="px-5 py-2.5 rounded-lg border transition-all duration-200 text-sm font-medium"
        style="border-color: var(--color-border); color: var(--color-text-muted);"
      >
        ← Anterior
      </button>
    )}

    <div class="flex-1"></div>

    <button
      type="submit"
      form="quiz-form"
      id="next-button"
      class="px-6 py-2.5 rounded-lg btn-primary text-sm font-medium"
    >
      {isLastQuestion ? 'Ver meus destinos →' : 'Próximo →'}
    </button>
  </div>
</div>

<script>
  // Quiz state management
  const STORAGE_KEY = 'stradello-match-responses';

  function getResponses() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : {};
    } catch (e) {
      console.error('Error reading from localStorage:', e);
      return {};
    }
  }

  function saveResponses(responses) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(responses));
    } catch (e) {
      console.error('Error saving to localStorage:', e);
    }
  }

  function clearResponses() {
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch (e) {
      console.error('Error clearing localStorage:', e);
    }
  }

  function updateOptionVisuals(radio) {
    const option = radio.closest('.quiz-option');
    const radioIndicator = option.querySelector('.quiz-radio');
    const radioDot = option.querySelector('.quiz-radio-dot');

    if (radio.checked) {
      option.style.borderColor = 'var(--color-accent)';
      option.style.background = 'var(--color-bg-alt)';
      radioIndicator.style.borderColor = 'var(--color-accent)';
      radioDot.style.opacity = '1';
    } else {
      option.style.borderColor = 'var(--color-border)';
      option.style.background = 'var(--color-bg-card)';
      radioIndicator.style.borderColor = 'var(--color-border)';
      radioDot.style.opacity = '0';
    }
  }

  // Initialize quiz
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('quiz-form');
    const prevButton = document.getElementById('prev-button');
    const currentQuestion = parseInt(form.dataset.currentQuestion);
    const isLast = form.dataset.isLast === 'true';
    const questionId = form.dataset.questionId;

    // Load saved response for this question
    const responses = getResponses();
    if (responses[questionId]) {
      const radio = form.querySelector(`input[name="${questionId}"][value="${responses[questionId]}"]`);
      if (radio) {
        radio.checked = true;
        updateOptionVisuals(radio);
      }
    }

    // Add change listeners to all radio inputs
    const radios = form.querySelectorAll('input[type="radio"]');
    radios.forEach(radio => {
      radio.addEventListener('change', () => {
        radios.forEach(r => updateOptionVisuals(r));
      });
    });

    // Add hover effects
    const options = form.querySelectorAll('.quiz-option');
    options.forEach(option => {
      option.addEventListener('mouseenter', () => {
        const radio = option.querySelector('input[type="radio"]');
        if (!radio.checked) {
          option.style.borderColor = 'var(--color-accent)';
          option.style.background = 'var(--color-bg-alt)';
        }
      });
      option.addEventListener('mouseleave', () => {
        const radio = option.querySelector('input[type="radio"]');
        if (!radio.checked) {
          option.style.borderColor = 'var(--color-border)';
          option.style.background = 'var(--color-bg-card)';
        }
      });
    });

    // Form submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const selected = form.querySelector(`input[name="${questionId}"]:checked`);
      if (!selected) {
        alert('Por favor, selecione uma opção para continuar.');
        return;
      }

      const value = selected.value;
      responses[questionId] = value;
      saveResponses(responses);

      if (isLast) {
        window.location.href = '/stradello-match/alternativas';
      } else {
        window.location.href = `/stradello-match/quiz?question=${currentQuestion + 1}`;
      }
    });

    // Previous button
    prevButton?.addEventListener('click', () => {
      const prevQuestion = prevButton.dataset.prev;
      window.location.href = `/stradello-match/quiz?question=${prevQuestion}`;
    });
  });
</script>
