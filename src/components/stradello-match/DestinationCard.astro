---
// ================================================================
// Stradello Match — Destination Card Component
// ================================================================

interface Props {
  slug: string;
  nome: string;
  estado: string;
  pais: string;
  descricao: string;
  imagem: string;
  score?: number;
  compatibility?: string;
  showScore?: boolean;
}

const {
  slug,
  nome,
  estado,
  pais,
  descricao,
  imagem,
  score,
  compatibility,
  showScore = false,
} = Astro.props;

const compatibilityLabels: Record<string, string> = {
  'excelente': 'Excelente compatibilidade',
  'muito-bom': 'Muito boa compatibilidade',
  'bom': 'Boa compatibilidade',
  'moderado': 'Compatibilidade moderada',
};

const compatibilityColors: Record<string, string> = {
  'excelente': 'bg-sage-100 dark:bg-sage-900/30 text-sage-700 dark:text-sage-300',
  'muito-bom': 'bg-stone-100 dark:bg-stone-800/30 text-stone-600 dark:text-stone-300',
  'bom': 'bg-terra-100 dark:bg-terra-900/30 text-terra-700 dark:text-terra-300',
  'moderado': 'bg-cream-100 dark:bg-cream-900/30 text-cream-700 dark:text-cream-300',
};
---

<article class="group relative rounded-xl overflow-hidden border transition-all duration-300 hover:shadow-lg"
  style="border-color: var(--color-border); background: var(--color-bg-card);"
>
  <!-- Image -->
  <a href={`/stradello-match/destino/${slug}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      {imagem ? (
        <img
          src={imagem}
          alt={nome}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          width="400"
          height="300"
        />
      ) : (
        <div
          class="w-full h-full flex items-center justify-center"
          style="background: linear-gradient(135deg, var(--color-bg-alt) 0%, color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)) 100%);"
        >
          <svg width="48" height="48" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M14 3C14 3 6 8 6 16C6 20.4183 9.58172 24 14 24C18.4183 24 22 20.4183 22 16C22 8 14 3 14 3Z" fill="var(--color-accent)" opacity="0.4" />
          </svg>
        </div>
      )}

      <!-- Score badge -->
      {showScore && score !== undefined && (
        <div class="absolute top-3 right-3 px-3 py-1.5 rounded-full text-xs font-medium" style="background: var(--color-bg); backdrop-filter: blur(8px);">
          <span style="color: var(--color-accent);">{Math.round(score)}% compatível</span>
        </div>
      )}
    </div>
  </a>

  <!-- Content -->
  <div class="p-5">
    <!-- Compatibility badge -->
    {showScore && compatibility && (
      <div class="mb-3">
        <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-medium ${compatibilityColors[compatibility] || compatibilityColors.bom}`}>
          {compatibilityLabels[compatibility] || compatibility}
        </span>
      </div>
    )}

    <!-- Location -->
    <p class="text-xs mb-1" style="color: var(--color-text-faint);">
      {estado}, {pais}
    </p>

    <!-- Title -->
    <h3 class="font-display font-semibold text-base mb-2 leading-tight" style="color: var(--color-heading); letter-spacing: -0.01em;">
      <a href={`/stradello-match/destino/${slug}`} class="transition-colors duration-200 hover:text-accent">
        {nome}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-muted);">
      {descricao}
    </p>
  </div>
</article>
