---
// ================================================================
// Stradello Match — Results Component
// ================================================================

import DestinationCard from './DestinationCard.astro';
import type { MatchResult } from '../../utils/matchAlgorithm';

interface Props {
  title: string;
  description: string;
  results: MatchResult[];
  showScore?: boolean;
}

const { title, description, results, showScore = true } = Astro.props;
---

<section class="section-gap">
  <div class="container-site">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <p class="section-label mb-3">Stradello Match</p>
      <h2 class="section-title mb-4">{title}</h2>
      <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
        {description}
      </p>
    </div>

    <!-- Results grid -->
    {results.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {results.map((result, index) => (
          <div class="reveal" style={`animation-delay: ${index * 0.1}s;`}>
            <DestinationCard
              slug={result.destination.slug}
              nome={result.destination.nome}
              estado={result.destination.estado}
              pais={result.destination.pais}
              descricao={result.destination.descricao}
              imagem={result.destination.imagem}
              score={showScore ? result.score : undefined}
              compatibility={showScore ? result.compatibility : undefined}
              showScore={showScore}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 rounded-2xl border" style="border-color: var(--color-border); background: var(--color-bg-alt);">
        <div class="text-4xl mb-4" aria-hidden="true">🌿</div>
        <p class="font-display text-xl font-medium mb-2" style="color: var(--color-heading);">
          Nenhum resultado encontrado
        </p>
        <p class="text-sm" style="color: var(--color-text-muted);">
          Tente responder ao quiz novamente para descobrir destinos que combinam com você.
        </p>
        <a href="/stradello-match/quiz" class="inline-flex items-center gap-2 mt-6 text-sm font-medium transition-colors duration-200" style="color: var(--color-accent);">
          Refazer quiz
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
