---
import { SITE, CATEGORIES, NAV_LINKS } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer
  class="mt-24 border-t"
  style="border-color: var(--color-border); background: var(--color-bg-alt);"
>
  <!-- Main footer content -->
  <div class="container-site py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 mb-5 group">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform duration-500 group-hover:rotate-12" aria-hidden="true">
            <path d="M14 3C14 3 6 8 6 16C6 20.4183 9.58172 24 14 24C18.4183 24 22 20.4183 22 16C22 8 14 3 14 3Z" fill="var(--color-accent)" opacity="0.8" />
            <path d="M14 24V12" stroke="var(--color-bg)" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="font-display text-lg font-medium" style="color: var(--color-heading); letter-spacing: -0.02em;">
            Stradello
          </span>
        </a>
        <p class="text-sm leading-relaxed mb-6 max-w-xs" style="color: var(--color-text-muted);">
          {SITE.tagline} — Um blog de viagens para quem prefere o silêncio ao barulho, o desvio ao caminho principal e a experiência autêntica ao roteiro óbvio.
        </p>

        
        <!-- Social links -->
        <div class="flex items-center gap-3">
          {SITE.social.instagram && (
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-lg transition-all duration-200"
              style="color: var(--color-text-muted);"
              aria-label="Stradello no Instagram"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          )}
          {SITE.social.pinterest && (
            <a
              href={SITE.social.pinterest}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-lg transition-all duration-200"
              style="color: var(--color-text-muted);"
              aria-label="Stradello no Pinterest"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigation column -->
      <div>
        <p class="text-xs font-medium uppercase tracking-widest mb-5" style="color: var(--color-accent);">
          Páginas
        </p>
        <ul class="flex flex-col gap-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm transition-colors duration-200"
                style="color: var(--color-text-muted);"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/recomendacoes" class="text-sm transition-colors duration-200" style="color: var(--color-text-muted);">
              Recomendações
            </a>
          </li>
          <li>
            <a href="/contato" class="text-sm transition-colors duration-200" style="color: var(--color-text-muted);">
              Contato
            </a>
          </li>
        </ul>
      </div>

      <!-- Categories column -->
      <div>
        <p class="text-xs font-medium uppercase tracking-widest mb-5" style="color: var(--color-accent);">
          Categorias
        </p>
        <ul class="flex flex-col gap-3">
          {CATEGORIES.slice(0, 6).map((cat) => (
            <li>
              <a
                href={`/categorias/${cat.slug}`}
                class="text-sm transition-colors duration-200 flex items-center gap-2"
                style="color: var(--color-text-muted);"
              >
                <span aria-hidden="true">{cat.emoji}</span>
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t" style="border-color: var(--color-border);">
    <div class="container-site py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs" style="color: var(--color-text-faint);">
      <p>
        &copy; {currentYear} {SITE.name}. Feito com calma e propósito.
      </p>
      <nav aria-label="Links legais" class="flex items-center gap-5">
        <a href="/privacidade" class="transition-colors duration-200 hover:text-muted">Privacidade</a>
        <a href="/termos" class="transition-colors duration-200 hover:text-muted">Termos</a>
        <a href="/rss.xml" class="transition-colors duration-200 hover:text-muted flex items-center gap-1">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20 4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
      </nav>
    </div>
  </div>
</footer>
